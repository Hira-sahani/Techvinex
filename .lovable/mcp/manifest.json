      {
        "name": "get_my_profile",
        "title": "Get my profile",
        "description": "Return the signed-in Techvinex user's profile row.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "update_my_profile",
        "title": "Update my profile",
        "description": "Update whitelisted fields on the signed-in Techvinex user's profile (name, contact, links, location). Sensitive fields cannot be changed here.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "patch": {
              "type": "object",
              "properties": {
                "full_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "phone": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 32
                },
                "linkedin": {
                  "type": "string",
                  "maxLength": 300,
                  "format": "uri"
                },
                "portfolio": {
                  "type": "string",
                  "maxLength": 300,
                  "format": "uri"
                },
                "github": {
                  "type": "string",
                  "maxLength": 300,
                  "format": "uri"
                },
                "leetcode": {
                  "type": "string",
                  "maxLength": 300,
                  "format": "uri"
                },
                "codechef": {
                  "type": "string",
                  "maxLength": 300,
                  "format": "uri"
                },
                "codeforces": {
                  "type": "string",
                  "maxLength": 300,
                  "format": "uri"
                },
                "country": {
                  "type": "string",
                  "maxLength": 80
                },
                "state": {
                  "type": "string",
                  "maxLength": 80
                },
                "city": {
                  "type": "string",
                  "maxLength": 80
                },
                "postal_code": {
                  "type": "string",
                  "maxLength": 20
                }
              },
              "additionalProperties": false,
              "description": "Object with the profile fields to update. Only include fields you want to change."
            }
          },
          "required": [
            "patch"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_explore_jobs",
        "title": "List explore jobs",
        "description": "List published Techvinex explore jobs (public listings visible to signed-in users).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max jobs to return. Defaults to 20.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "search": {
              "description": "Optional case-insensitive substring to match in the job title.",
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "search_explore_jobs",
        "title": "Search explore jobs",
        "description": "Search published Techvinex explore jobs by keyword, location, category, job type, or skills. Returns the newest matches first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Case-insensitive substring matched against title and short description.",
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "location": {
              "description": "Case-insensitive substring matched against the job location.",
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "category": {
              "description": "Exact category match (e.g. 'engineering').",
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "job_type": {
              "description": "Exact job type (e.g. 'full-time', 'contract').",
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "skills": {
              "description": "Skills the job must include (AND semantics).",
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "limit": {
              "description": "Max jobs to return. Defaults to 20.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "offset": {
              "description": "Pagination offset. Defaults to 0.",
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_explore_job",
        "title": "Get explore job",
        "description": "Fetch a single Techvinex explore job by id or slug (public listing fields only).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "description": "Job UUID.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "slug": {
              "description": "Job slug.",
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "outputSchema": null
      },
